# opencodepp-static.pc.in -- pkg-config entry for the static library.
prefix=${pcfiledir}/@OPENCODE_PC_TO_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: opencodepp-static
Description: Hyper-efficient, embeddable C++ agentic-coding engine (static lib)
Version: @PROJECT_VERSION@
Requires.private: @OPENCODE_PKG_PRIVATE_LIBS@
Libs: -L${libdir} -lopencodepp_static -pthread
Cflags: -I${includedir}
